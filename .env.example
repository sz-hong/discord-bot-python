# Discord Bot Token (必填)
DISCORD_TOKEN=your_discord_bot_token_here

# Spotify OAuth2 (必填，用於同步播放和自動推薦)
# 從 https://developer.spotify.com/dashboard 取得
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Spotify OAuth2 回調地址
# 本地測試用 http://127.0.0.1:8888/callback
# 雲端部署改成你的伺服器地址，例如 https://your-domain.com/callback
# 必須和 Spotify Dashboard 中設定的 Redirect URI 一致
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# YouTube Cookie (選填，用於繞過地區/年齡限制)
# 將 cookies.txt 的內容轉成單行，換行用 \n，Tab 用 \t
YOUTUBE_COOKIE=

# Last.fm API Key (選填，但建議設定；用於相似歌曲推薦)
# 從 https://www.last.fm/api/account/create 申請
LASTFM_API_KEY=

# 自動播放推薦設定
AUTOPLAY_LOW_WATERMARK=2
AUTOPLAY_TARGET_SIZE=5
